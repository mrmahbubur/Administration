{
  "entities": {
    "Review": {
      "title": "Review",
      "description": "Verified client review and rating for M R S services",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the reviewer"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Display name of the reviewer"
        },
        "roleOrCompany": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional role, client title, or location"
        },
        "serviceUsed": {
          "type": "string",
          "enum": [
            "Remote IT Support",
            "Virtual Assistance & Admin",
            "Professional CV Design",
            "Blogspot & WordPress Management",
            "Student Earning Guidance",
            "General Consultation"
          ],
          "description": "Service category reviewed"
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "Short summary headline for the review"
        },
        "comment": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000,
          "description": "Detailed client feedback"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "authorUid",
        "authorName",
        "roleOrCompany",
        "serviceUsed",
        "rating",
        "title",
        "comment",
        "createdAt",
        "updatedAt"
      ]
    },
    "ArticleComment": {
      "title": "ArticleComment",
      "description": "Reader discussion comment on an article",
      "type": "object",
      "properties": {
        "articleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID of the article"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the commenter"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Display name of the commenter"
        },
        "text": {
          "type": "string",
          "minLength": 2,
          "maxLength": 800,
          "description": "Comment body"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": [
        "articleId",
        "authorUid",
        "authorName",
        "text",
        "createdAt"
      ]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Client service inquiry or project waitlist submission",
      "type": "object",
      "properties": {
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the sender"
        },
        "senderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Name of the sender"
        },
        "senderEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Email or contact handle"
        },
        "serviceCategory": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Requested service or project"
        },
        "urgency": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Timeline or urgency"
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000,
          "description": "Inquiry details"
        },
        "status": {
          "type": "string",
          "enum": ["new", "reviewed", "archived"],
          "description": "Inquiry workflow status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": [
        "senderUid",
        "senderName",
        "senderEmail",
        "serviceCategory",
        "urgency",
        "message",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/Review"
      },
      "description": "Verified public client reviews and ratings"
    },
    "/article_comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/ArticleComment"
      },
      "description": "Reader discussion comments linked to articles"
    },
    "/inquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/entities/Inquiry"
      },
      "description": "Private service inquiries and beta waitlist requests"
    }
  }
}
